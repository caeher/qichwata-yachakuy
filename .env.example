# Copy to .env.local for local development.
# Next.js loads .env.local and does not commit it.

# NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL. Local or Neon (use the pooled URL, sslmode=require).
# Not required for `pnpm build` or `pnpm test`.
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/stellar_data_integrity
DATABASE_URL=

# Clerk. Leave empty in CI. `pnpm build` must succeed without these.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Same signing secret in both names. verifyWebhook reads CLERK_WEBHOOK_SIGNING_SECRET.
CLERK_WEBHOOK_SECRET=
CLERK_WEBHOOK_SIGNING_SECRET=

# Yachay coach (server only). Keep disabled until a reviewed Quechua quality
# evaluation approves a model. These variables never use NEXT_PUBLIC_ prefixes.
OPENAI_COACH_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=
# Process-local requests/day cap for early pilots. Also configure an OpenAI
# project spend limit; this request cap is not a monetary budget guarantee.
OPENAI_COACH_DAILY_REQUEST_LIMIT=1000

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Stellar. Server-only. Never prefix these with NEXT_PUBLIC_.
# `pnpm build` and `pnpm test` succeed when the key and the secret are empty.
# STELLAR_NETWORK: testnet (default) or mainnet.
STELLAR_NETWORK=testnet

# Alchemy Free app, chain Stellar. Testnet host is
# https://stellar-testnet.g.alchemy.com/v2/<key>
# Mainnet host is https://stellar-mainnet.g.alchemy.com/v2/<key>
# Websocket (not used by the app): wss://stellar-testnet.g.alchemy.com/v2/<key>
# Empty key → testnet uses https://soroban-testnet.stellar.org
# and Horizon https://horizon-testnet.stellar.org.
# Empty key on mainnet → Horizon https://horizon.stellar.org only
# (no official public mainnet Soroban RPC).
ALCHEMY_STELLAR_API_KEY=

# Hot wallet and Soroban contract (#6/#7). Leave empty for CI.
STELLAR_HOT_WALLET_SECRET=
STELLAR_CONTRACT_ID=

# Education/certificates. Keep issuer empty until product and academic policy
# are approved. Configure a strong server-only token and call
# POST /api/jobs/certificates from a scheduler (for example, once per minute).
CERTIFICATE_ISSUER=
CERTIFICATE_WORKER_TOKEN=

# Native XLM floor for the hot-wallet alert. Empty uses 10 (testnet) or 20 (mainnet).
# Empty is valid. CI does not call Horizon for this.
STELLAR_HOT_WALLET_MIN_XLM=
